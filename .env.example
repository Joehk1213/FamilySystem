PORT=3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FAMILY_ID=
OPENROUTER_API_KEY=
# Optional; only free model IDs are accepted. Defaults to google/gemma-4-31b-it:free.
OPENROUTER_MODEL=
# Dev Phase fictional-data webhook only; requires NODE_ENV=development and TELEGRAM_DEV_MODE=true.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TEST_CHAT_ID=
TELEGRAM_DEV_MODE=false
# Required only for the fictional seed accounts. Do not use a real password.
SEED_TEST_USER_PASSWORD=
# Required only for fictional RLS test accounts in a disposable test project.
RLS_TEST_PASSWORD=
# Explicitly confirm npm run test:rls targets a disposable test project.
RLS_TEST_PROJECT_CONFIRM=
# Optional local BGE model directory; takes precedence over FAMILY_RAG_MODEL_PATH.
FAMILY_RAG_MODEL_ROOT=
