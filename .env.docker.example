# Copy to .env.docker on JOE-SERVER. Keep generated values private and never commit .env.docker.
FAMILY_DATA_ROOT=D:/docker-data/family-system

# Generate with: node scripts/generate-supabase-keys.js
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_HEX_SECRET
JWT_SECRET=REPLACE_WITH_GENERATED_VALUE
SUPABASE_ANON_KEY=REPLACE_WITH_GENERATED_VALUE
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_GENERATED_VALUE

# Host-side seed and test URL; the gateway binds only to loopback.
SUPABASE_URL=http://127.0.0.1:8000
FAMILY_ID=11111111-1111-4111-8111-111111111111

# Configure these URLs for the HTTPS reverse proxy and deployed app.
SUPABASE_PUBLIC_URL=https://family.example.invalid
API_EXTERNAL_URL=https://family.example.invalid/auth/v1
SITE_URL=https://family.example.invalid
ADDITIONAL_REDIRECT_URLS=http://localhost:3002,https://family.example.invalid
# Exact browser origin allowed by the gateway; set the production frontend origin, never "*".
CORS_ALLOWED_ORIGIN=http://localhost:3002

# Google OAuth is disabled until real provider credentials are configured locally.
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=

PORT=3002
SEED_TEST_USER_PASSWORD=REPLACE_WITH_DISPOSABLE_FAKE_ACCOUNT_PASSWORD
RLS_TEST_PASSWORD=REPLACE_WITH_DISPOSABLE_FAKE_ACCOUNT_PASSWORD
RLS_TEST_PROJECT_CONFIRM=I_AM_USING_A_DISPOSABLE_TEST_PROJECT
