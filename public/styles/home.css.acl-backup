:root {
  --bg: #fafaf9;
  --panel: #fff;
  --text: #1a1a1a;
  --accent: #6366f1;
  --radius: 16px;
  --shadow-soft: 0 2px 16px rgba(0, 0, 0, 0.06);
}

body.home-chat-active {
  color: var(--text);
  background: var(--bg);
  font-size: 16px;
  line-height: 1.6;
}

body.home-chat-active .page-shell {
  width: min(100% - 48px, 1440px);
}

body.home-chat-active #app {
  margin: 12px 0;
}

body.home-chat-active .mvp-header,
body.home-chat-active .mvp-nav,
body.home-chat-active .family-chat-sidebar,
body.home-chat-active .family-chat-main,
body.home-chat-active .home-rag-panel {
  border-color: #e8e7e4;
  border-radius: var(--radius);
  background: var(--panel);
  box-shadow: var(--shadow-soft);
}

body.home-chat-active .family-chat-sidebar,
body.home-chat-active .family-chat-main {
  padding: 24px;
}

body.home-chat-active .home-rag-panel {
  padding: 16px;
}

body.home-chat-active .mvp-content {
  display: block;
  width: 100%;
  max-width: none;
  padding: 0;
}

body.home-chat-active .mvp-nav {
  margin: 12px 0;
}

body.home-chat-active .mvp-nav a,
body.home-chat-active .home-chat-layout button {
  min-height: 44px;
  transition-duration: 150ms;
}

.home-chat-layout {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  grid-template-rows: minmax(0, 1fr) 160px;
  gap: 16px;
  align-items: stretch;
  height: calc(100dvh - 244px);
  min-height: 560px;
}

.home-sidebar {
  position: sticky;
  top: 12px;
  grid-column: 1;
  grid-row: 1 / 3;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  min-height: 0;
  overflow: hidden;
}

.home-sidebar-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  margin-top: 16px;
  padding: 4px;
  border-radius: 10px;
  background: #f3f2f0;
}

.home-sidebar-tabs button {
  min-height: 44px;
  padding: 8px 12px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #57534e;
  font-weight: 650;
}

.home-sidebar-tabs button[aria-pressed="true"] {
  background: var(--panel);
  color: var(--accent);
  box-shadow: 0 2px 8px rgb(26 26 26 / 8%);
}

.home-sidebar-panel {
  min-height: 0;
  margin-top: 12px;
  overflow: hidden;
}

.home-sidebar-panel[hidden] {
  display: none !important;
}

.home-chat-history,
.home-sidebar-panel .family-chat-history {
  display: grid;
  gap: 8px;
  height: 100%;
  max-height: none;
  margin: 0;
  overflow: auto;
  overscroll-behavior: contain;
}

.home-history-item {
  width: 100%;
}

.home-center {
  grid-column: 2;
  grid-row: 1;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr) auto;
  min-height: 0;
  overflow: hidden;
}

.home-center .family-chat-heading {
  align-items: center;
}

.home-center .family-chat-privacy {
  margin: 10px 0;
}

.home-center .family-chat-results {
  min-height: 0;
  max-height: none;
  overscroll-behavior: contain;
}

.home-composer {
  gap: 12px;
  margin-top: 16px;
}

.home-composer textarea {
  min-height: 56px;
  max-height: 200px;
  padding: 12px 16px;
  font-size: 16px;
  line-height: 1.6;
  resize: none;
  overflow-y: auto;
}

.home-drop {
  position: relative;
  grid-template-columns: 44px minmax(0, 1fr);
  align-items: center;
  gap: 12px;
  padding: 16px;
  border-color: #c7c5c1;
  border-radius: var(--radius);
  background: #fcfcfb;
  transition: border-color 150ms ease, background-color 150ms ease, box-shadow 150ms ease;
}

.home-drop.is-dragging,
.home-drop:focus-within {
  border-color: var(--accent);
  background: #f4f3ff;
  box-shadow: 0 0 0 3px rgb(99 102 241 / 12%);
}

.home-drop-copy {
  display: grid;
  gap: 4px;
  min-width: 0;
}

.home-drop-icon {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border-radius: 14px;
  background: #f4f3ff;
  color: var(--accent);
}

.home-drop-icon svg {
  width: 22px;
  height: 22px;
}

.home-drop input {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.home-drop:hover {
  border-color: #a5a2f5;
  background: #faf9ff;
}

.home-drop .family-chat-drop-title {
  color: var(--text);
  font-size: 1rem;
  font-weight: 650;
}

.home-storage-note {
  color: #78716c;
  font-size: 0.78rem;
  line-height: 1.4;
}

.home-attachment-chip {
  grid-column: 2;
  width: fit-content;
  max-width: 100%;
  margin-top: 4px;
  padding: 5px 10px;
  overflow: hidden;
  border: 1px solid #d9d7ff;
  border-radius: 999px;
  background: #f4f3ff;
  color: #4338ca;
  font-size: 0.8rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-attachment-chip[hidden] {
  display: none !important;
}

.home-composer .family-chat-actions {
  justify-content: flex-end;
}

.home-rag-panel {
  grid-column: 2;
  grid-row: 2;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  min-width: 0;
  height: 160px;
  min-height: 160px;
  overflow: hidden;
}

.home-rag-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.home-rag-heading h3 {
  margin: 0;
  color: var(--text);
  font-size: 0.95rem;
}

.home-rag-heading span {
  color: #78716c;
  font-size: 0.78rem;
  font-weight: 650;
}

.home-memory-chips {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  min-width: 0;
  min-height: 0;
  padding-top: 10px;
  overflow: auto hidden;
  overscroll-behavior: contain;
}

.home-memory-chip {
  flex: 0 0 auto;
  max-width: 240px;
  min-height: 44px;
  padding: 8px 14px;
  overflow: hidden;
  border: 1px solid #e8e7e4;
  border-radius: 999px;
  background: #fafaf9;
  color: #44403c;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-memory-chip:hover,
.home-memory-chip:focus-visible {
  border-color: var(--accent);
  color: #4338ca;
}

.home-memory-chips .mvp-empty {
  margin: 0;
  color: #78716c;
  font-size: 0.84rem;
}

body.home-chat-active :focus-visible {
  outline-color: rgb(99 102 241 / 48%);
  outline-width: 3px;
  outline-offset: 3px;
}

.home-typing-state {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #78716c;
}

.home-typing-indicator {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-height: 44px;
}

.home-typing-indicator i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
  animation: home-typing-pulse 900ms ease-in-out infinite;
}

.home-typing-indicator i:nth-child(2) {
  animation-delay: 150ms;
}

.home-typing-indicator i:nth-child(3) {
  animation-delay: 300ms;
}

@keyframes home-typing-pulse {
  0%, 60%, 100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-4px);
  }
}

@media (max-width: 760px) {
  body.home-chat-active .page-shell {
    width: min(100% - 28px, 620px);
  }

  .home-chat-layout {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(200px, auto) minmax(520px, auto) 160px;
    height: auto;
    min-height: 0;
  }

  .home-sidebar {
    position: static;
    grid-column: 1;
    grid-row: 1;
    min-height: 200px;
  }

  .home-center {
    grid-column: 1;
    grid-row: 2;
  }

  .home-rag-panel {
    grid-column: 1;
    grid-row: 3;
  }

  .home-center .family-chat-heading,
  .home-center .family-chat-actions {
    align-items: stretch;
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  .home-drop,
  .home-typing-indicator i {
    transition: none;
    animation: none;
  }
}

body.living-wall-active {
  min-height: 100dvh;
  overflow: hidden;
  background: #dce8df;
}

body.living-wall-active .page-shell {
  position: relative;
  z-index: 1;
  width: 100%;
  min-height: 100dvh;
}

body.living-wall-active .site-header,
body.living-wall-active .site-footer {
  display: none;
}

.living-photo-wall {
  position: fixed;
  z-index: 0;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  background: linear-gradient(135deg, #dce8df, #f3e7d9 48%, #d7e5ef);
}

.living-photo-wall img {
  position: absolute;
  width: var(--photo-width);
  height: var(--photo-height);
  border: 5px solid rgb(255 255 255 / 92%);
  border-radius: 20px;
  object-fit: cover;
  opacity: 0.65;
  box-shadow: 0 12px 32px rgb(22 34 31 / 18%);
  animation: living-photo-drift var(--drift-duration) ease-in-out infinite alternate var(--drift-delay);
  will-change: transform;
}

.living-photo-wall img:nth-child(1) {
  top: 5%;
  left: 7%;
  --photo-width: 22vw;
  --photo-height: 24vh;
  --drift-x: 80px;
  --drift-y: 70px;
  --drift-duration: 8.1s;
  --drift-delay: -1s;
}

.living-photo-wall img:nth-child(2) {
  top: 12%;
  right: 8%;
  --photo-width: 20vw;
  --photo-height: 22vh;
  --drift-x: 86px;
  --drift-y: 76px;
  --drift-duration: 8.4s;
  --drift-delay: -2s;
}

.living-photo-wall img:nth-child(3) {
  bottom: 8%;
  left: 5%;
  --photo-width: 24vw;
  --photo-height: 25vh;
  --drift-x: 92px;
  --drift-y: 82px;
  --drift-duration: 8.7s;
  --drift-delay: -3s;
}

.living-photo-wall img:nth-child(4) {
  right: 4%;
  bottom: 7%;
  --photo-width: 23vw;
  --photo-height: 24vh;
  --drift-x: 98px;
  --drift-y: 88px;
  --drift-duration: 9s;
  --drift-delay: -4s;
}

.living-photo-wall img:nth-child(5) {
  top: 29%;
  left: 3%;
  --photo-width: 19vw;
  --photo-height: 21vh;
  --drift-x: 84px;
  --drift-y: 94px;
  --drift-duration: 9.3s;
  --drift-delay: -5s;
}

.living-photo-wall img:nth-child(6) {
  top: 27%;
  right: 5%;
  --photo-width: 21vw;
  --photo-height: 23vh;
  --drift-x: 90px;
  --drift-y: 72px;
  --drift-duration: 9.6s;
  --drift-delay: -6s;
}

.living-photo-wall img:nth-child(7) {
  bottom: 27%;
  left: 10%;
  --photo-width: 20vw;
  --photo-height: 22vh;
  --drift-x: 96px;
  --drift-y: 78px;
  --drift-duration: 9.9s;
  --drift-delay: -7s;
}

.living-photo-wall img:nth-child(8) {
  right: 11%;
  bottom: 26%;
  --photo-width: 22vw;
  --photo-height: 24vh;
  --drift-x: 82px;
  --drift-y: 84px;
  --drift-duration: 10.2s;
  --drift-delay: -8s;
}

.living-photo-wall img:nth-child(9) {
  top: 3%;
  left: 28%;
  --photo-width: 18vw;
  --photo-height: 19vh;
  --drift-x: 88px;
  --drift-y: 90px;
  --drift-duration: 10.5s;
  --drift-delay: -9s;
}

.living-photo-wall img:nth-child(10) {
  top: 4%;
  right: 28%;
  --photo-width: 19vw;
  --photo-height: 20vh;
  --drift-x: 94px;
  --drift-y: 96px;
  --drift-duration: 10.8s;
  --drift-delay: -1.5s;
}

.living-photo-wall img:nth-child(11) {
  bottom: 4%;
  left: 27%;
  --photo-width: 21vw;
  --photo-height: 22vh;
  --drift-x: 100px;
  --drift-y: 86px;
  --drift-duration: 11.3s;
  --drift-delay: -3.5s;
}

.living-photo-wall img:nth-child(12) {
  right: 27%;
  bottom: 3%;
  --photo-width: 20vw;
  --photo-height: 21vh;
  --drift-x: 86px;
  --drift-y: 100px;
  --drift-duration: 11.9s;
  --drift-delay: -5.5s;
}

@keyframes living-photo-drift {
  from {
    transform: translate3d(0, 0, 0) scale(0.85);
  }
  to {
    transform: translate3d(var(--drift-x), var(--drift-y), 0) scale(1.25);
  }
}

.living-photo-wall-topbar {
  position: fixed;
  z-index: 4;
  inset: 0 0 auto;
  height: 48px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 12px;
  border-bottom: 1px solid rgb(255 255 255 / 65%);
  background: rgb(255 255 255 / 78%);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.living-wall-spacer {
  flex: 1;
}

.living-wall-icon-button {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 12px;
  color: #33423a;
  background: transparent;
  font-size: 1.15rem;
}

.living-wall-icon-button:hover {
  background: rgb(42 72 56 / 8%);
}

.living-wall-role-badge {
  max-width: min(32vw, 180px);
  padding: 6px 12px;
  overflow: hidden;
  border: 1px solid rgb(61 91 70 / 16%);
  border-radius: 999px;
  color: #355342;
  background: rgb(238 247 239 / 90%);
  font-size: 0.78rem;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

body.living-wall-active #app {
  position: fixed;
  z-index: 1;
  inset: 0;
  width: 100%;
  height: 100dvh;
  min-height: 100dvh;
  display: grid;
  place-items: center;
  margin: 0;
  padding: 68px 16px 76px;
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

body.living-wall-active .auth-panel,
body.living-wall-active .mvp-login-panel {
  width: min(440px, calc(100vw - 32px));
  max-width: none;
  margin: 0;
  padding: clamp(24px, 5vw, 40px);
  border: 1px solid rgb(255 255 255 / 78%);
  border-radius: 24px;
  background: rgb(255 255 255 / 92%);
  box-shadow: 0 20px 60px rgb(22 34 31 / 20%);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  text-align: center;
}

body.living-wall-active #record-editor {
  position: fixed;
  z-index: 2;
  top: 50%;
  left: 50%;
  width: min(520px, calc(100vw - 32px));
  max-height: calc(100dvh - 116px);
  margin: 0;
  padding: 44px 24px 24px;
  overflow: auto;
  transform: translate(-50%, -50%);
  border: 1px solid rgb(255 255 255 / 72%);
  border-radius: 24px;
  background: rgb(255 255 255 / 92%);
  box-shadow: 0 20px 60px rgb(22 34 31 / 22%);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.living-photo-public-pill {
  position: absolute;
  top: 14px;
  right: 20px;
  padding: 4px 9px;
  border: 1px solid #d5e7db;
  border-radius: 999px;
  color: #45684f;
  background: #edf6ef;
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}

body.living-wall-active #record-editor .chat-heading,
body.living-wall-active #record-editor .chat-heading .description,
body.living-wall-active #record-editor .chat-mode-badge,
body.living-wall-active #record-editor #quick-chips,
body.living-wall-active #record-editor .draft-storage-opt-in,
body.living-wall-active #record-editor .chat-privacy-note {
  display: none !important;
}

body.living-wall-active #record-content {
  min-height: 82px;
}

.living-wall-functions {
  position: fixed;
  z-index: 3;
  bottom: 8px;
  left: 50%;
  width: min(960px, calc(100vw - 32px));
  max-height: 48vh;
  overflow: auto;
  transform: translateX(-50%);
  border: 1px solid rgb(255 255 255 / 78%);
  border-radius: 16px;
  background: rgb(255 255 255 / 94%);
  box-shadow: 0 12px 36px rgb(22 34 31 / 16%);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.living-wall-functions summary {
  min-height: 44px;
  display: flex;
  align-items: center;
  padding: 10px 16px;
  color: #405447;
  font-size: 0.86rem;
  font-weight: 700;
  list-style: none;
}

.living-wall-functions summary::-webkit-details-marker {
  display: none;
}

.living-wall-functions summary::before {
  content: "嚗?;
  margin-right: 9px;
  font-size: 1rem;
}

.living-wall-functions[open] summary::before {
  content: "??;
}

.living-wall-functions-content {
  display: grid;
  gap: 12px;
  padding: 0 12px 12px;
}

.living-wall-functions-content > #records-list,
.living-wall-functions-content > .dashboard-sidebar {
  min-width: 0;
  display: grid;
  gap: 12px;
  margin: 0;
}

.living-wall-functions-content > #records-list {
  padding: 18px;
}

.living-wall-functions-content .sign-out-button,
.living-wall-functions-content [data-action="sign-out"] {
  justify-self: end;
}

@media (max-width: 600px) {
  .living-photo-wall img:nth-child(2),
  .living-photo-wall img:nth-child(5),
  .living-photo-wall img:nth-child(8),
  .living-photo-wall img:nth-child(11) {
    display: none;
  }

  .living-photo-wall img {
    border-width: 4px;
    border-radius: 15px;
  }

  body.living-wall-active #record-editor {
    padding: 40px 16px 16px;
  }

  body.living-wall-active .auth-panel,
  body.living-wall-active .mvp-login-panel {
    padding: 24px 18px;
  }

  .living-wall-functions-content > #records-list {
    padding: 14px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .living-photo-wall img {
    animation: none;
    will-change: auto;
  }
}
